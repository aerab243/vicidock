# Copier vers .env : cp .env.example .env
# Tag d'image : une version de VICIdial (ex. 2.14-3939) ou latest
VICIDOCK_TAG=latest
# Révision SVN VICIdial pour un build local (numéro épinglé, ex. 3939)
VICIDIAL_SVN_REV=3939
MYSQL_ROOT_PASSWORD=changez_moi_root
MYSQL_CRON_PASSWORD=changez_moi_cron
CUSTOM_PASSWORD=changez_moi_custom
SERVER_IP=127.0.0.1
# Fuseau du serveur (système + PHP + MariaDB). Exemples : Europe/Paris,
# America/New_York. Doit correspondre à l'heure réelle du serveur.
TZ=UTC
# Mots de passe : lettres/chiffres uniquement, éviter ' " \ et espaces
# (interprétés par l'entrypoint MySQL).
