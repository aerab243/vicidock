# Copier vers .env : cp .env.example .env
# Tag d'image : une version de VICIdial (ex. 2.14-3939) ou latest
VICIDOCK_TAG=latest
# Révision SVN VICIdial pour un build local (HEAD ou numéro, ex. 3939)
VICIDIAL_SVN_REV=HEAD
MYSQL_ROOT_PASSWORD=changez_moi_root
MYSQL_CRON_PASSWORD=changez_moi_cron
CUSTOM_PASSWORD=changez_moi_custom
SERVER_IP=127.0.0.1
